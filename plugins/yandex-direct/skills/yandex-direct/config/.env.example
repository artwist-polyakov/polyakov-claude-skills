# OAuth-токен пользователя с доступом к API Директа или ключ совместимого прокси.
# Получение и выбор способа подключения — API_ACCESS.md и README.md.
YANDEX_DIRECT_TOKEN=

# Логин рекламного кабинета — значение ulogin в его адресе в Директе.
# Например: YANDEX_DIRECT_ACCOUNT=client-shop
# Для агентства укажите логин клиента, которому принадлежит реклама.
# --account и сохранённый выбор accounts.py --use имеют приоритет.
# Если неархивный кабинет единственный, он выбирается сам; поле можно оставить пустым.
# Пример выбора и переключения кабинетов — README.md.
YANDEX_DIRECT_ACCOUNT=

YANDEX_DIRECT_LOCALE=ru
YANDEX_DIRECT_USE_OPERATOR_UNITS=auto

# Необязательные настройки: без них запросы идут напрямую в Яндекс Директ.
# Базовый адрес для v5, v501 и reports; пути сервисов добавляются автоматически.
# YANDEX_DIRECT_API_BASE_URL=https://api.direct.yandex.com
# База v4: при нестандартной основной базе наследуется из неё, если не задана.
# YANDEX_DIRECT_API_BASE_URL_V4=https://api.direct.yandex.ru
# Дополнительные заголовки отправляются только через прокси: "Имя: значение; Имя2: значение2".
# YANDEX_DIRECT_API_EXTRA_HEADERS=
# Только для локальных тестов: разрешает HTTP на localhost и 127.0.0.1.
# YANDEX_DIRECT_ALLOW_INSECURE_HTTP=0
