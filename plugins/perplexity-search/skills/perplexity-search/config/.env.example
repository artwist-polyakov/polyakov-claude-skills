# perplexity-search — config
# Copy to .env to activate: cp config/.env.example config/.env
# Keep the file shell-compatible: quote any value that contains spaces.

# ─── API credentials ─────────────────────────────────────────
# Create a key at https://www.perplexity.ai/account/api (Settings → API).
# The key is billed per request — see references/API_REFERENCE.md for prices.
PERPLEXITY_API_KEY=pplx-your-key-here

# ─── Defaults for ask.sh / research.sh ───────────────────────
# Preset picks model + tools in one shot:
#   fast   — gpt-5.4-mini + web_search, cheapest lookups
#   low    — everyday research with fetch_url
#   medium — multi-hop browsing (default)
#   high   — expert reasoning, exhaustive sources
#   xhigh  — agentic work with a code sandbox
#   wide-research — large evidence-backed collections
PPLX_PRESET=medium

# Optional explicit model, overrides the preset's model.
# Examples: perplexity/sonar, openai/gpt-5.6-sol, anthropic/claude-sonnet-5
# PPLX_MODEL=perplexity/sonar

# ─── Search defaults ─────────────────────────────────────────
# How much page text is extracted per result: low | medium | high
PPLX_CONTEXT_SIZE=medium

# Results per Search API request (1..20)
PPLX_MAX_RESULTS=10

# ISO 3166-1 alpha-2 country for region-aware search, e.g. RU, US
# PPLX_COUNTRY=RU

# ISO 639-1 language: answer language for ask.sh, result filter for search.sh
# PPLX_LANGUAGE=ru

# ─── Cache ───────────────────────────────────────────────────
# Seconds an identical request may be served from cache/. 0 = always live.
PPLX_CACHE_TTL=900
# Deep research runs are expensive; keep their reports for a day.
PPLX_RESEARCH_CACHE_TTL=86400

# ─── Output / transport ──────────────────────────────────────
# Default number of stdout lines before the rest is left in cache files.
PPLX_PRINT_LIMIT=30
# curl --max-time per request, seconds. Raise for xhigh presets.
PPLX_HTTP_TIMEOUT=300
# Attempts per request on 429/5xx (with Retry-After / exponential backoff).
PPLX_MAX_RETRIES=3

# ─── Source profiles ─────────────────────────────────────────
# Named bundles of domain/recency/context defaults, applied with --profile.
# Registry — the agent reads this to know which profiles exist.
PPLX_PROFILES=news,science

PPLX_PROFILE_NEWS_LABEL="Tech news"
PPLX_PROFILE_NEWS_DOMAINS=techcrunch.com,theverge.com,arstechnica.com
PPLX_PROFILE_NEWS_RECENCY=week
PPLX_PROFILE_NEWS_CONTEXT=low

PPLX_PROFILE_SCIENCE_LABEL="Peer-reviewed sources"
PPLX_PROFILE_SCIENCE_DOMAINS=nature.com,science.org,arxiv.org,pubmed.ncbi.nlm.nih.gov
PPLX_PROFILE_SCIENCE_CONTEXT=high

# Add your own:
# 1. Append the id to PPLX_PROFILES
# 2. Define PPLX_PROFILE_<ID>_DOMAINS (and optionally _LABEL, _RECENCY, _CONTEXT)
#
# Denylist form — prefix every domain with '-' (allow and deny cannot be mixed):
# PPLX_PROFILE_CLEAN_LABEL="No forums"
# PPLX_PROFILE_CLEAN_DOMAINS=-reddit.com,-quora.com,-pinterest.com
